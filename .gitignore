# Bundler cache
.bundle
vendor

# NOTE: Gemfile.lock is intentionally COMMITTED. Cloudflare Pages builds the
# site itself, so an unpinned theme lets the deployed jekyll-theme-chirpy
# version drift away from the copies of its files vendored under _includes/
# and _layouts/ -- which has broken the live site more than once. See
# tools/check-theme-sync.sh.

# Jekyll cache
.jekyll-cache
.jekyll-metadata
_site

# Sanity-sourced posts (regenerated on every build, never committed)
_posts/sanity/

# pnpm lockfile (pnpm stays the local dev tool; Cloudflare installs with npm)
pnpm-lock.yaml

# RubyGems
*.gem

# NPM dependencies
node_modules

# IDE configurations
.idea
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/tasks.json

# Misc
_sass/vendors
assets/js/dist

# Wrangler
.wrangler

# Migration tool output
tools/migrate-mt-image-map.yml
